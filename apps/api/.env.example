# API environment — copy to apps/api/.env and adjust
DATABASE_URL="postgresql://coe:coe_secret@localhost:5432/creative_ops?schema=public"
REDIS_URL="redis://localhost:6379"
# REDIS_URL=""

JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

PORT=4000

# Comma separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000

# Storage driver: 'local' or 'r2' (Cloudflare R2 / AWS S3 compatible)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Cloudflare R2 (optional)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
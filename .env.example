# ------------------------------------------------------------------
# Root environment template — copy to .env and adjust
# ------------------------------------------------------------------

# Shared JWT secrets (must match between .env and apps/api/.env)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Application ports
API_PORT=4000
WEB_PORT=3000

# API base URL used by the web app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Realtime Socket.IO URL used by the web app
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional: Cloudflare R2 / AWS S3 credentials
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=creative-ops
# S3_PUBLIC_URL=
